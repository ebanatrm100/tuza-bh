  "verses": [
    {
      "bookId": 1,
      "chapter": 1,
      "verse": 1,
      "text": "Muri mbere Imana yaremye ijuru n'isi."
    },
    {
      "bookId": 1,
      "chapter": 1,
      "verse": 2,
      "text": "Isi yari ubutayu kandi ubusa, umwijima wari hejuru y'amazi mbere, kandi Umwuka w'Imana yagendagendaga hejuru y'amazi."
    },
    {
      "bookId": 1,
      "chapter": 1,
      "verse": 3,
      "text": "Imana ivuga iti: \"Habemo umucyo!\" Umucyo urabaho."
    },
    {
      "bookId": 1,
      "chapter": 1,
      "verse": 4,
      "text": "Imana ibona ko umucyo ari mwiza, itandukanya umucyo n'umwijima."
    },
    {
      "bookId": 1,
      "chapter": 1,
      "verse": 5,
      "text": "Imana yita umucyo ijoro, n'umwijima yita joro. Haba umugoroba, haba mu gitondo, ni umunsi wa mbere."
    },
    {
      "bookId": 19,
      "chapter": 23,
      "verse": 1,
      "text": "Uwiteka ni umwungeri wanjye, sinzabura icyo nkeneye."
    },
    {
      "bookId": 19,
      "chapter": 23,
      "verse": 2,
      "text": "Anyamika mu byatsi bishyushye, anderekeza ku mazi atuje."
    },
    {
      "bookId": 19,
      "chapter": 23,
      "verse": 3,
      "text": "Ahumuriza ubugingo bwanjye, antwara mu nzira zikiranuka ku bw'izina rye."
    },
    {
      "bookId": 19,
      "chapter": 23,
      "verse": 4,
      "text": "Ndetse nanyuze mu kinzira cy'igicucu cy'urupfu, ntatinye ikibi, kuko uri kumwe nanjye; inkoni yawe n'umuhotora wawe ni byo bimpumuriza."
    },
    {
      "bookId": 19,
      "chapter": 23,
      "verse": 5,
      "text": "Utegurira imbere y'ababisha ameza, usiga amavuta mu mutwe wanjye, ikirahuri cyanjye kirenze."
    },
    {
      "bookId": 19,
      "chapter": 23,
      "verse": 6,
      "text": "Ni ukuri, ibyiza n'imbabazi bizankurikira iminsi yose y'ubugingo bwanjye, kandi nzabana n'Uwiteka iteka ryose."
    },
    {
      "bookId": 43,
      "chapter": 3,
      "verse": 16,
      "text": "Kuko Imana yakunze abari mu isi cyane, ku buryo yatanze Umwana wayo w'ikinege, kugira ngo umwizera wese atarimbuka, ahubwo abone ubugingo buhoraho."
    },
    {
      "bookId": 43,
      "chapter": 3,
      "verse": 17,
      "text": "Imana ntiyatumye Umwana wayo mu isi ngo ace urubanza isi, ahubwo ngo isi izakizwe na we."
    }
  ],
  "hymns": [
    {
      "number": 1,
      "title": "Imana y'Ubuntu",
      "lyrics": "Imana y'ubuntu, tuzamuhimbaze,\nku bw'urukundo rwayo rudashira.\n\nTwese hamwe, twese hamwe,\nturamuhe icyubahiro.",
      "chorus": "Tuzamuhimbaze, tuzamuhimbaze,\nImana y'ubuntu ku isi yose.",
      "category": "praise"
    },
    {
      "number": 2,
      "title": "Yesu ni Umwami",
      "lyrics": "Yesu ni Umwami w'ijuru n'isi,\nni we Murokora wacu.\n\nTuvuge amasezerano ye,\nhari mu isi yose.",
      "chorus": "Yesu ni Umwami, Yesu ni Umwami,\nni we Murokora w'isi yose.",
      "category": "salvation"
    },
    {
      "number": 3,
      "title": "Murakoze Imana",
      "lyrics": "Murakoze Imana yacu,\nku bw'ubuntu bwawe bwinshi.\n\nUduhe umugisha,\niminsi yose y'ubugingo.",
      "chorus": "Murakoze, murakoze,\nImana yacu y'urukundo.",
      "category": "praise"
    },
    {
      "number": 4,
      "title": "Uwiteka ni Umwungeri",
      "lyrics": "Uwiteka ni umwungeri wanjye,\nsinzabura icyo nkeneye.\n\nAnyamika ku byatsi bishyushye,\nanderekeza ku mazi atuje.",
      "chorus": "Uwiteka ni umwungeri wanjye,\nsinzabura icyo nkeneye.",
      "category": "praise"
    },
    {
      "number": 5,
      "title": "Ijwi ryiza ryanyu",
      "lyrics": "Ijwi ryiza ryanyu, Yesu,\nryampamagariye iwawe.\n\nNimwumve ijwi ry'Umwami,\nmu byishimo n'urukundo.",
      "chorus": "Nimwumve ijwi ry'Umwami,\nryiza, ryiza, rituma ndohoka.",
      "category": "salvation"
    },
    {
      "number": 6,
      "title": "Umucyo w'isi",
      "lyrics": "Yesu ni umucyo w'isi,\nukira mu mwijima.\n\nTugende mu mucyo we,\nkugira ngo tuzabone.",
      "chorus": "Yesu ni umucyo w'isi,\ntugende mu mucyo we.",
      "category": "salvation"
    },
    {
      "number": 7,
      "title": "Halleluya",
      "lyrics": "Halleluya, Halleluya,\nTuvuze Uwiteka.\n\nHalleluya, Halleluya,\nImana yacu ni nziza.",
      "chorus": "Halleluya, Halleluya,\nImana yacu ni nziza.",
      "category": "praise"
    },
    {
      "number": 8,
      "title": "Nzaguma hafi yawe",
      "lyrics": "Nzaguma hafi yawe, Yesu,\nmu byishimo no mu kubabara.\n\nNdagusaba umwete,\nkugira ngo ntsinde.",
      "chorus": "Nzaguma hafi yawe, Yesu,\niminsi yose y'ubugingo.",
      "category": "salvation"
    }
  ]
}
